// Basé sur HANCORE-linux/waybar-themes V7.2a, adapté sans Omarchy
// Couleurs des <span> : switch-theme.sh remplace foreground='…' par l'accent
// du thème et fgcolor='…' par sa couleur atténuée (themes/<thème>/colors.css)
{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "mod": "dock",
  "passthrough": false,
  "margin-top": 0,
  "margin-left": 50,
  "margin-right": 50,
  "margin-bottom": 0,
  "modules-left": [
    "custom/weather",
    "custom/separator3",
    "clock",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "idle_inhibitor",
    "power-profiles-daemon",
    "bluetooth",
    "custom/separator",
    "custom/updatespacman",
    "backlight",
    "battery"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "group/tray-expander",
    "network",
    "cpu",
    "memory",
    "pulseaudio#input",
    "pulseaudio#output",
    "custom/separator",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    },
    "persistent-workspaces": {
      "*": 10
    }
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "custom/separator3": {
    "format": "•",
    "tooltip": false
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 60,
    "exec-if": "which wttrbar",
    "exec": "wttrbar --nerd",
    "return-type": "json"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "on-click-right": "kitty",
    "tooltip-format": "Menu d'alimentation"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": " ",
      "power-saver": ""
    }
  },
  "cpu": {
    "interval": 5,
    "format": "<span foreground='#974b46'>cpu</span> {usage:02}%",
    "on-click": "kitty -e top",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "memory": {
    "interval": 5,
    "format": "<span foreground='#974b46'>mem</span> {percentage:02}%",
    "tooltip-format": "Used {percentage}%\n{used:0.1f}GB/{total:0.1f}GB",
    "on-click": "kitty -e top",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip": true,
    "tooltip-format": "Brightness:  {percent}%",
    "format-alt": "{percent}% {icon}",
    "format-alt-click": "click-right",
    "format-icons": ["󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%"
  },
  "clock": {
    "format": "<span foreground='#974b46'>{0:%H:%M}</span> <span size='small' fgcolor='#505050'><i>{0:%a, %b %d}</i></span>",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<b>{}</b>",
        "weekdays": "<span fgcolor='#505050'><b>{}</b></span>",
        "today": "<span foreground='#974b46'><b>{}</b></span>"
      }
    }
  },
  "network": {
    "format": "<span foreground='#974b46'>net</span> on",
    "format-wifi": "<span foreground='#974b46'>wifi</span> {essid}",
    "format-ethernet": "<span foreground='#974b46'>eth</span> on",
    "format-disconnected": "<span foreground='#974b46'>net</span> off",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "wlogout",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "{num_connections}",
    "format-disabled": "󰂲 {status}",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },
  "pulseaudio#input": {
    "format": "<span foreground='#974b46'>mic</span> {source_volume}%",
    "format-muted": "<span foreground='#974b46'>mic</span> muted",
    "tooltip-format": "mic {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%"
  },
  "pulseaudio#output": {
    "format": "<span foreground='#974b46'>vol</span> {volume}%",
    "format-muted": "<span foreground='#974b46'>vol</span> muted",
    "tooltip-format": "vol {volume}%",
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "mpris": {
    "format": "{dynamic}",
    "format-paused": "<span foreground='#974b46'>paused</span> {dynamic}",
    "interval": 5,
    "dynamic-order": ["artist", "position", "length"],
    "dynamic-importance-order": ["position", "length", "artist"],
    "tooltip-format": "{player} ({status}):\n{artist} - {title}",
    "ignored-players": ["firefox", "brave"]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Stay Awake: ON",
    "tooltip-format-deactivated": "Stay Awake: OFF",
    "format-icons": {
      "activated": "󰛨",
      "deactivated": "󰛩"
    }
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󰏖",
      "updated": ""
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output"
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },
  "tray": {
    "icon-size": 13,
    "spacing": 2
  }
}
