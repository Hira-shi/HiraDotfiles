{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "battery", "network", "custom/sound", "custom/nmtui", "custom/wlogout"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    }
  },

  "clock": {
    "format": "{:%H:%M}"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""]
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪"
  },

  "custom/sound": {
    "format": "󰕾",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },

  "custom/nmtui": {
    "format": "󰈀",
    "tooltip": false,
    "on-click": "kitty -e nmtui"
  },

  "custom/wlogout": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "tray": {
    "spacing": 8
  }
}
